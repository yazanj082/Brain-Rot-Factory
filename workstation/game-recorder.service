[Unit]
Description=Continuous Hardware-Accelerated Game Recorder
After=graphical-session.target pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/home/yazan/Documents/Projects/brain-rot-factory/scripts/start_recording.sh
Restart=on-failure
RestartSec=5
# Pass through the logged-in desktop session so the Wayland portal picker appears
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

[Install]
WantedBy=graphical-session.target
